#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

require_cmd jq
require_cmd curl

FLUENT_BIT_BIN="${FLUENT_BIT_BIN:-fluent-bit}"
if ! command -v "$FLUENT_BIT_BIN" >/dev/null 2>&1; then
  echo "Fluent Bit executable not found: $FLUENT_BIT_BIN" >&2
  exit 1
fi

fluent_bit_version="$("$FLUENT_BIT_BIN" --version | head -1)"

RESOURCE_DIR="${RESOURCE_DIR:-$SCRIPT_DIR/../../../azure-resources/az-monitor-otel-logs-2}"
DCR_PATH="${DCR_PATH:-$RESOURCE_DIR/dcr.json}"
SERVICE_PRINCIPAL_PATH="${SERVICE_PRINCIPAL_PATH:-$RESOURCE_DIR/service-principal.json}"
RESOURCE_GROUP="${RESOURCE_GROUP:-az-monitor-otel-logs-2-rg}"
RULE_NAME="${RULE_NAME:-az-monitor-otel-logs-2-rule}"
RUN_SECONDS="${RUN_SECONDS:-15}"
KEEP_LOG="${KEEP_LOG:-false}"
export HTTP_PORT="${HTTP_PORT:-2021}"
AUTH_PORT="${AUTH_PORT:-2022}"

if [[ ! -f "$DCR_PATH" ]]; then
  require_cmd az
  DCR_PATH="$(mktemp "${TMPDIR:-/tmp}/fluent-bit-dcr.XXXXXX")"
  az monitor data-collection rule show \
    --resource-group "$RESOURCE_GROUP" \
    --rule-name "$RULE_NAME" \
    --output json >"$DCR_PATH"
  remove_dcr_path=true
else
  remove_dcr_path=false
fi

export DCE_URL="$(jq -er '.endpoints.logsIngestion' "$DCR_PATH")"
export DCR_ID="$(jq -er '.immutableId' "$DCR_PATH")"

log_path="$(mktemp "${TMPDIR:-/tmp}/fluent-bit-2mb-uncompressed.XXXXXX")"
storage_path="$(mktemp "${TMPDIR:-/tmp}/fluent-bit-2mb-uncompressed-storage.XXXXXX")"
fluent_bit_pid=""
auth_server_pid=""

cleanup() {
  if [[ -n "$fluent_bit_pid" ]] && kill -0 "$fluent_bit_pid" 2>/dev/null; then
    kill -TERM "$fluent_bit_pid"
    wait "$fluent_bit_pid" 2>/dev/null || true
  fi

  if [[ -n "$auth_server_pid" ]] && kill -0 "$auth_server_pid" 2>/dev/null; then
    kill -TERM "$auth_server_pid"
    wait "$auth_server_pid" 2>/dev/null || true
  fi

  if [[ "$KEEP_LOG" != "true" ]]; then
    rm -f "$log_path" "$storage_path"
  fi

  if [[ "$remove_dcr_path" == "true" ]]; then
    rm -f "$DCR_PATH"
  fi
}
trap cleanup EXIT

if [[ -f "$SERVICE_PRINCIPAL_PATH" ]]; then
  export TENANT_ID="$(jq -er '.tenant' "$SERVICE_PRINCIPAL_PATH")"
  export CLIENT_ID="$(jq -er '.appId' "$SERVICE_PRINCIPAL_PATH")"
  export CLIENT_SECRET="$(jq -er '.password' "$SERVICE_PRINCIPAL_PATH")"
  export AUTH_URL="https://login.microsoftonline.com/${TENANT_ID}/oauth2/v2.0/token"
  auth_description="service principal"
else
  require_cmd az
  require_cmd python3

  token_response="$(
    az account get-access-token \
      --resource https://monitor.azure.com \
      --output json
  )"
  access_token="$(jq -er '.accessToken' <<<"$token_response")"
  expires_on="$(jq -er '.expires_on // .expiresOn' <<<"$token_response")"

  export TENANT_ID="azure-cli"
  export CLIENT_ID="azure-cli"
  export CLIENT_SECRET="azure-cli"
  export AUTH_URL="http://127.0.0.1:${AUTH_PORT}/token"
  auth_description="current Azure CLI session"

  ACCESS_TOKEN="$access_token" EXPIRES_ON="$expires_on" AUTH_PORT="$AUTH_PORT" \
    python3 -c '
import json
import os
from http.server import BaseHTTPRequestHandler, HTTPServer

payload = json.dumps({
    "access_token": os.environ["ACCESS_TOKEN"],
    "expires_in": 3600,
    "expires_on": os.environ["EXPIRES_ON"],
    "token_type": "Bearer",
}).encode()

class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, format, *args):
        pass

HTTPServer(("127.0.0.1", int(os.environ["AUTH_PORT"])), Handler).serve_forever()
' &
  auth_server_pid=$!
fi

echo "Using $fluent_bit_version"
echo "Authenticating with the $auth_description."
echo "Generating 30,000 records in small batches with the Fluent Bit dummy input."
echo "Sending chunks with azure_logs_ingestion compress=false."

"$FLUENT_BIT_BIN" -c ./fluent-bit.yaml >"$log_path" 2>&1 &
fluent_bit_pid=$!

metrics_url="http://127.0.0.1:${HTTP_PORT}/api/v1/storage"
metrics_deadline=$((SECONDS + 15))
metrics_ready=false
while (( SECONDS < metrics_deadline )); do
  if curl --fail --silent "$metrics_url" --output /dev/null; then
    metrics_ready=true
    break
  fi
  sleep 0.25
done

if [[ "$metrics_ready" == "true" ]]; then
  sleep 4
  if curl --fail --silent "$metrics_url" --output "$storage_path"; then
    jq -r '
      .input_chunks["dummy.0"]
      | "Buffered before flush: \(.status.mem_size) across \(.chunks.total) chunks."
    ' "$storage_path"
  else
    echo "Unable to read Fluent Bit chunk metrics before the flush." >&2
  fi
else
  echo "Unable to read Fluent Bit chunk metrics before the flush." >&2
fi

deadline=$((SECONDS + RUN_SECONDS))
while kill -0 "$fluent_bit_pid" 2>/dev/null && (( SECONDS < deadline )); do
  sleep 1
done

if kill -0 "$fluent_bit_pid" 2>/dev/null; then
  kill -TERM "$fluent_bit_pid"
fi
wait "$fluent_bit_pid" 2>/dev/null || true
fluent_bit_pid=""

echo
grep -E \
  'http_status=[0-9]{3}|ContentLengthLimitExceeded|Maximum allowed content length|retrying payload bytes=' \
  "$log_path" || true
echo

if grep -qE 'http_status=413' "$log_path"; then
  echo "FAIL: Azure Monitor rejected a full uncompressed chunk as too large." >&2
  result=1
elif grep -qE 'http_status=(401|403)' "$log_path"; then
  echo "BLOCKED: Azure authentication succeeded, but this identity lacks permission to ingest through the DCR." >&2
  result=1
elif ! grep -qE 'http_status=[0-9]{3}' "$log_path"; then
  echo "No Azure HTTP response was observed. Fluent Bit log tail:" >&2
  tail -40 "$log_path" >&2
  result=1
elif grep -qE 'http_status=2[0-9]{2}' "$log_path" &&
   ! grep -qE 'http_status=[45][0-9]{2}' "$log_path"; then
  echo "PASS: Azure Monitor accepted every uncompressed Fluent Bit chunk."
  result=0
else
  echo "FAIL: Azure Monitor did not accept every uncompressed Fluent Bit chunk." >&2
  result=1
fi

if [[ "$KEEP_LOG" == "true" ]]; then
  echo "Fluent Bit log: $log_path"
  echo "Storage metrics: $storage_path"
fi

exit "$result"
